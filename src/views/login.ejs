<%-include ('partials/header')%>
<main class="auth-page login-page">
    <h1><%=title%></h1>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="email">Email (username)</label>
            <input id="email" type="email" name="email" autocomplete="username" placeholder="Enter email" required>
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input id="password" type="password" name="password" autocomplete="current-password" placeholder="Enter password" required>
        </div>
        <button type="submit">Login</button>
    </form>
</main>

<%-include ('partials/footer')%>
