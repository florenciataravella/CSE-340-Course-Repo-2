<%-include ('partials/header') %>
    <main class="collection-page categories-page">
        <h1><%= title %></h1>
        <p>Here are a few of our service categories:</p>
        <ul>
            <% categories.forEach(category => { %>
                <li><a class="card-link" href="/category/<%= category.category_id %>">
                    <strong><%=category.category_name%></strong> <%=category.description%>
                </a></li>
            <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>
