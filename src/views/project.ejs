<%- include ('partials/header.ejs') %>
<main>
    <h1><%= title %></h1>
    <h2><%= projectDetails.project_name %></h2>
     <p>Description: <%= projectDetails.description %></p>
    <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.name %></a></p>
    <p>Categories: </p>
    <ul>
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
        <% }); %>
    </ul>
</main>
