<%- include ('partials/header.ejs') %>
<main>
<h1><%= title %></h1>
<h2><%= categoryDetails.category_name %></h2>
<p><%= categoryDetails.description %></p>
<h3>Projects in this category:</h3>
<ul>
    <% categoryDetails.projects.forEach(project => { %>
        <li><a href="/project/<%= project.project_id %>"><strong><%= project.project_name %></strong></a></li>
    <% }); %>
</ul>
</main>
<%- include ('partials/footer.ejs') %>
