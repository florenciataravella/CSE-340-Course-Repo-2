<%- include ('partials/header.ejs') %>
<main>
<h1><%= title %></h1>
<h2><%= categoryDetails.category_name %></h2>
<p><%= categoryDetails.description %></p>
<h3>Projects in this category:</h3>
<ul>
    <% categoryDetails.projects.forEach(project => { %>
        <li><a href="/project/<%= project.project_id %>"><strong><%= project.project_name %></strong></a></li>
    <% }); %>
</ul>
<% if (user && user.role_name === 'admin') { %>
<div class="detail-actions"><a class="action-link" href="/edit-category/<%= categoryDetails.category_id %>">Edit Category</a>
</div>
<% } %>; 
</main>
<%- include ('partials/footer.ejs') %>
