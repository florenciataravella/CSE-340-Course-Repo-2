<%- include ('partials/header.ejs')%>

<main class="users-page">
    <h1><%=title%></h1>
    <ul>
        <% users.forEach(user=>{ %>
            <li class="user-entry">
                <h2><%=user.name%></h2>
                <p><span>Email</span><a href="mailto:<%=user.email%>"><%=user.email%></a></p>
                <p><span>Role</span><strong><%=user.role_name%></strong></p>
            </li>
        <% }) %>
    </ul>
</main>
<%-include ('partials/footer.ejs')%>