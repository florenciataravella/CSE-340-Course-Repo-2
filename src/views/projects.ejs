<%-include('partials/header') %>
    <main class="collection-page projects-page">
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
<ul>
    <% projects.forEach(project => { %>
        <li>
            <a class="card-link" href="/project/<%= project.project_id %>"><strong><%= project.project_name %></strong></a>
            <span>Hosted by <a class="organization-link" href="/organization/<%= project.organization_id %>"><%= project.name %></a></span>
        </li>
    <% }); %>
</ul>
    </main>
    <%- include('partials/footer') %>
