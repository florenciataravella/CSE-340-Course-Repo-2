<%-include ('partials/header')%>
<main class="dashboard-page">
    <h1><%=title%></h1>

    <section class="dashboard-welcome" aria-label="Account overview">
        <p class="dashboard-greeting">Welcome, <strong><%=name%></strong>!</p>
        <p class="dashboard-username"><span>Username</span><strong><%=email%></strong></p>
    </section>
    <% if(user && user.role_name === 'admin'){%>
        <p class="create-link"><a class="btn" href="/users">See users</a></p>
    <% } %>

</main>
<%-include ('partials/footer.ejs')%>
